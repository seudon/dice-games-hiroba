---
// src/pages/games/[slug].astro
import { getCollection } from 'astro:content';
import GameLayout from '../../layouts/GameLayout.astro';
import GameHost from '../../components/games/GameHost.vue';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map(game => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content } = await game.render();

/**
 * ゲームコンポーネントの存在確認
 *
 * 実際のマウントは GameHost.vue が動的に行うため、このファイルは
 * ゲームが増えても編集不要。ただし綴り間違いや置き忘れが実行時まで
 * 発覚しないと困るので、ビルド時にここで検証する。
 */
const availableGames = Object.keys(
  import.meta.glob('../../components/games/*.vue')
)
  .map(path => path.split('/').pop())
  .filter(name => name !== 'GameHost.vue');   // ホスト自身は選択肢ではない

if (!availableGames.includes(game.data.component)) {
  throw new Error(
    `ゲームコンポーネントが見つかりません: "${game.data.component}" (${game.slug})\n` +
    `src/components/games/ に置かれているか、frontmatterの component の綴りを確認してください。\n` +
    `利用可能: ${availableGames.join(', ')}`
  );
}

// 難易度に応じたバッジカラー
const difficultyColors: Record<string, string> = {
  '初級': 'bg-success',
  '中級': 'bg-info',
  '上級': 'bg-warning',
  '超級': 'bg-danger',
};

const baseUrl = import.meta.env.BASE_URL;
---

<GameLayout
  title={game.data.title}
  description={game.data.description}
>
  <!--
    ゲーム本体をファーストビューに入れるため、ヘッダーは1画面に収まる高さに抑える。
    詳しいルールや戦略はゲームの下に折りたたんで置く。
  -->
  <div class="mb-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <h1 class="h2 fw-bold mb-0">{game.data.title}</h1>
      <span class={`badge ${difficultyColors[game.data.difficulty]}`}>
        {game.data.difficulty}
      </span>
      {game.data.category.map((cat: string) => (
        <span class="badge bg-secondary">{cat}</span>
      ))}
    </div>

    <p class="text-dark mb-2">{game.data.description}</p>

    <div class="d-flex flex-wrap gap-3 small text-dark">
      <span>
        <span>👥</span>
        <span>{game.data.players}</span>
      </span>
      <span>
        <span>⏱️</span>
        <span>{game.data.duration}</span>
      </span>
      <span>
        <span>🎲</span>
        <span>サイコロ{game.data.diceCount}個</span>
      </span>
    </div>
  </div>

  <!-- クイックルール(これだけ読めば遊べる要点) -->
  <div class="alert alert-info py-2 mb-3">
    <span class="badge bg-primary me-2">ルール</span>
    <span>{game.data.quickRule}</span>
  </div>

  <!-- ゲーム本体(インタラクティブ) -->
  <div class="bg-light rounded p-3 p-md-4 mb-4">
    <GameHost
      client:only="vue"
      component={game.data.component}
      gameSlug={game.slug}
      config={game.data.config ?? {}}
    >
      <div slot="fallback" class="text-center text-dark py-5">
        ゲームを読み込んでいます...
      </div>
    </GameHost>
  </div>

  <!--
    詳しいルール・戦略・実際のサイコロでの遊び方。
    detailsを使うことでJavaScript不要かつキーボード操作にも対応できる。
  -->
  <details class="mb-4">
    <summary class="btn btn-secondary w-100 text-start">
      詳しいルールと戦略を読む
    </summary>

    <div class="card border-top-0 rounded-top-0">
      <div class="card-body text-dark">
        <Content />

        {game.data.tags && game.data.tags.length > 0 && (
          <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
            {game.data.tags.map((tag: string) => (
              <span class="badge bg-secondary">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </details>

  <!-- ナビゲーション -->
  <div class="text-center pt-3 border-top">
    <a href={`${baseUrl}/games/`} class="btn btn-primary">
      ← ゲーム一覧に戻る
    </a>
  </div>
</GameLayout>
