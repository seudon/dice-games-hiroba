---
// src/pages/games/[slug].astro
import { getCollection } from 'astro:content';
import GameLayout from '../../layouts/GameLayout.astro';
import GameHost from '../../components/games/GameHost.vue';
import { formatPlayers, difficultyColors } from '../../lib/utils/game';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map(game => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content } = await game.render();

/**
 * ゲームコンポーネントの存在確認
 *
 * 実際のマウントは GameHost.vue が動的に行うため、このファイルは
 * ゲームが増えても編集不要。ただし綴り間違いや置き忘れが実行時まで
 * 発覚しないと困るので、ビルド時にここで検証する。
 */
const availableGames = Object.keys(
  import.meta.glob('../../components/games/*.vue')
)
  .map(path => path.split('/').pop())
  .filter(name => name !== 'GameHost.vue');   // ホスト自身は選択肢ではない

if (!availableGames.includes(game.data.component)) {
  throw new Error(
    `ゲームコンポーネントが見つかりません: "${game.data.component}" (${game.slug})\n` +
    `src/components/games/ に置かれているか、frontmatterの component の綴りを確認してください。\n` +
    `利用可能: ${availableGames.join(', ')}`
  );
}

const playersLabel = formatPlayers(game.data.players);
const baseUrl = import.meta.env.BASE_URL;
---

<GameLayout
  title={game.data.title}
  description={game.data.description}
>
  <!-- 画面表示用。印刷時は下のルールカードだけを出す -->
  <div class="d-print-none">
  <!--
    ゲーム本体をファーストビューに入れるため、ヘッダーは1画面に収まる高さに抑える。
    詳しいルールや戦略はゲームの下に折りたたんで置く。
  -->
  <div class="mb-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <h1 class="h2 fw-bold mb-0">{game.data.title}</h1>
      <span class={`badge ${difficultyColors[game.data.difficulty]}`}>
        {game.data.difficulty}
      </span>
      {game.data.category.map((cat: string) => (
        <span class="badge bg-secondary">{cat}</span>
      ))}
    </div>

    <p class="small text-dark mb-2">{game.data.description}</p>

    <div class="d-flex flex-wrap gap-3 small text-dark">
      <span>
        <span>👥</span>
        <span>{playersLabel}</span>
      </span>
      <span>
        <span>⏱️</span>
        <span>{game.data.duration}</span>
      </span>
      <span>
        <span>🎲</span>
        <span>サイコロ{game.data.diceCount}個</span>
      </span>
    </div>
  </div>

  <!-- ゲーム本体(インタラクティブ) -->
  <div class="bg-light rounded p-2 p-md-4 mb-3">
    <GameHost
      client:only="vue"
      component={game.data.component}
      gameSlug={game.slug}
      config={game.data.config ?? {}}
    >
      <div slot="fallback" class="text-center text-dark py-5">
        ゲームを読み込んでいます...
      </div>
    </GameHost>
  </div>

  <!--
    クイックルール。
    サイコロと操作ボタンをできるだけ画面上部に出すため、ゲームの直後に置く。
    「触ってみて分からなければすぐ下を読む」という順序を想定している。
  -->
  <div class="alert alert-info py-2 mb-4 small">
    <span class="badge bg-primary me-2">ルール</span>
    <span>{game.data.quickRule}</span>
  </div>

  <!--
    実物のサイコロで遊ぶための情報。
    ブラウザ版は練習台であり、実際のサイコロで遊ぶのが本来の姿という位置づけ。
  -->
  <div class="card border-primary mb-4">
    <div class="card-header bg-white fw-bold">
      🎲 実物のサイコロで遊ぶ
    </div>
    <div class="card-body">
      <p class="text-dark">
        このゲームは実際のサイコロがあれば、みんなで囲んで遊べます。
        ブラウザ版はルールを覚えるための練習台です。
      </p>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <div class="fw-bold text-dark mb-2">必要なもの</div>
          <ul class="text-dark mb-0">
            {game.data.equipment.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="col-md-6">
          <div class="fw-bold text-dark mb-2">遊ぶ目安</div>
          <ul class="text-dark mb-0">
            <li>人数: {playersLabel}</li>
            <li>時間: {game.data.duration}</li>
          </ul>
        </div>
      </div>

      <button type="button" class="btn btn-primary" data-print-rules>
        ルールカードを印刷する
      </button>
      <div class="small text-dark mt-2">
        必要なもの・ルール・得点記録表を1枚にまとめて印刷します。
      </div>
    </div>
  </div>

  <!--
    詳しいルール・戦略。
    detailsを使うことでJavaScript不要かつキーボード操作にも対応できる。
  -->
  <details class="mb-4">
    <summary class="btn btn-secondary w-100 text-start">
      詳しいルールと戦略を読む
    </summary>

    <div class="card border-top-0 rounded-top-0">
      <div class="card-body text-dark">
        <Content />

        {game.data.tags && game.data.tags.length > 0 && (
          <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
            {game.data.tags.map((tag: string) => (
              <span class="badge bg-secondary">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </details>

  <!-- ナビゲーション -->
  <div class="text-center pt-3 border-top">
    <a href={`${baseUrl}/games/`} class="btn btn-primary">
      ← ゲーム一覧に戻る
    </a>
  </div>
  </div>

  <!--
    印刷用ルールカード
    画面には出さず、印刷したときだけ1枚もので出力する。
    サイコロを囲んで遊ぶときに手元に置くことを想定している。
  -->
  <div class="d-none d-print-block">
    <!--
      ページ側で既に<h1>を出しているため、ここは見出しタグにしない。
      印刷物としての見た目だけをh3相当に揃える。
    -->
    <div class="h3 fw-bold">{game.data.title}</div>
    <p class="text-dark">{game.data.description}</p>

    <table class="table table-sm table-borderless w-auto mb-3">
      <tbody>
        <tr>
          <th class="pe-3 text-nowrap">必要なもの</th>
          <td>{game.data.equipment.join(' / ')}</td>
        </tr>
        <tr>
          <th class="pe-3 text-nowrap">人数</th>
          <td>{playersLabel}</td>
        </tr>
        <tr>
          <th class="pe-3 text-nowrap">遊ぶ時間</th>
          <td>{game.data.duration}</td>
        </tr>
      </tbody>
    </table>

    <div class="h5 fw-bold">ルール</div>
    <p class="text-dark">{game.data.quickRule}</p>

    <div class="h5 fw-bold">得点記録表</div>
    <table class="table table-bordered">
      <thead>
        <tr>
          <th class="text-center">回</th>
          <th>プレイヤー1</th>
          <th>プレイヤー2</th>
          <th>プレイヤー3</th>
          <th>プレイヤー4</th>
        </tr>
      </thead>
      <tbody>
        {Array.from({ length: 12 }, (_, i) => (
          <tr>
            <td class="text-center">{i + 1}</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
          </tr>
        ))}
        <tr>
          <th class="text-center">合計</th>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
        </tr>
      </tbody>
    </table>

    <p class="small text-dark">
      サイコロゲーム広場 — {Astro.site?.href ?? ''}dice-games-hiroba/games/{game.slug}/
    </p>
  </div>
</GameLayout>

<script>
  // 「ルールカードを印刷する」ボタン
  document.querySelectorAll('[data-print-rules]').forEach(button => {
    button.addEventListener('click', () => window.print());
  });
</script>
